# Supabase Postgres 연결 문자열 (Transaction Pooler 권장)
# Supabase 대시보드 > Project Settings > Database > Connection string > "Transaction pooler"
# 예: postgresql://postgres.fjgwjmjjfpaldxnkhwbd:[YOUR-DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# (호스트/리전은 반드시 대시보드의 실제 문자열을 복사하세요. 이 프로젝트 ref=fjgwjmjjfpaldxnkhwbd)
DATABASE_URL=

# MCP 접근 키 (PlayMCP 에 x-api-key 헤더로 등록할 값). 비워두면 인증 없이 통과(개발용)
TRIPMONEY_API_KEY=

# 프로토타입 모드. mock 으로 두면 DATABASE_URL 없이도 / 또는 /prototype 대시보드를 시연할 수 있습니다.
TRIPMONEY_PROTOTYPE_MODE=mock

# (선택) 웹 데모 API 보호키. 설정하면 브라우저에서 처음 호출할 때 키를 묻고 localStorage 에 저장합니다.
TRIPMONEY_WEB_DEMO_KEY=

# (선택) 네이버 CLOVA OCR — 영수증 자동 추출. 둘 다 설정 시 scanReceipt 가 amount 없이도 자동 인식
# NCP 콘솔 > CLOVA OCR > 도메인(영수증) 생성 후 APIGW Invoke URL / Secret Key
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
