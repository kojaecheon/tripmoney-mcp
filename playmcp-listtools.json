            "default": "editor"
          },
          "bank_name": {
            "type": "string",
            "description": "송금 딥링크용 은행명"
          },
          "account_no": {
            "type": "string",
            "description": "송금 딥링크용 계좌번호"
          },
          "trip_key": {
            "type": "string",
            "description": "보호 여행방의 접근키"
          }
        },
        "required": [
          "trip_id",
          "name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
