{
  "tools": [
    {
      "name": "createTrip",
      "title": "여행방 생성",
      "description": "[트립머니] 같이 여행 가는 사람들을 위한 공유 공간(여행방)을 만든다. 기준 통화, 기간, 초기 멤버를 함께 등록할 수 있다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "여행방 이름"
          },
          "base_currency": {
            "type": "string",
            "default": "KRW",
            "description": "정산 기준 통화 (기본 KRW)"
          },
          "start_date": {
            "type": "string",
            "description": "시작일 YYYY-MM-DD"
          },
          "end_date": {
            "type": "string",
            "description": "종료일 YYYY-MM-DD"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "owner",
                    "editor",
                    "viewer"
                  ],
                  "default": "editor"
                },
                "bank_name": {
                  "type": "string",
                  "description": "송금 딥링크용 은행명"
                },
                "account_no": {
                  "type": "string",
                  "description": "송금 딥링크용 계좌번호"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "description": "초기 멤버 목록 (role: owner/editor 는 수정 가능, viewer 는 조회만)"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "여행방 생성",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
