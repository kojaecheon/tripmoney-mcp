    {
      "name": "addExpense",
      "title": "비용 직접 등록",
      "description": "[트립머니] 비용을 직접 입력한다. 현지통화로 입력하면 실시간 환율로 기준통화(보통 한화) 환산액이 함께 저장된다. 카드/현금 구분, 일정 귀속, N빵/커스텀 분담 지원.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "trip_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "description": "현지(입력) 통화 금액"
          },
          "currency": {
            "type": "string",
            "description": "입력 통화(기본=여행방 기준통화)"
          },
          "payer_member_id": {
            "type": "string",
            "description": "결제한 멤버 id"
          },
          "schedule_id": {
            "type": "string",
            "description": "귀속 일정 id"
          },
          "pay_method": {
            "type": "string",
            "enum": [
              "card",
              "cash"
            ],
            "default": "card"
          },
          "exchange_rate": {
            "type": "number",
            "description": "1 현지통화 = ? 기준통화. 미지정 시 실시간 환율 자동 조회"
          },
          "spent_at": {
            "type": "string",
            "description": "지출 시각 ISO8601"
          },
          "note": {
            "type": "string"
          },
          "actor_member_id": {
            "type": "string"
          },
          "trip_key": {
            "type": "string",
            "description": "보호 여행방의 접근키"
          },
          "split_mode": {
            "type": "string",
            "enum": [
              "equal",
              "custom",
              "payer"
            ],
            "default": "equal",
            "description": "equal=참여자 균등 N빵, custom=직접 분담, payer=결제자 전액"
          },
          "split_member_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "equal 분담 참여자(미지정 시 전원)"
          },
          "custom_shares": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "member_id": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                }
              },
              "required": [
                "member_id",
                "amount"
              ],
              "additionalProperties": false
            },
            "description": "custom 모드 멤버별 부담액(기준통화)"
          }
        },
        "required": [
          "trip_id",
          "title",
          "amount"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "비용 직접 등록",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "scanReceipt",
      "title": "영수증 기반 비용 등록",
      "description": "[트립머니] 영수증 사진으로 비용을 등록한다. 이미지를 base64(receipt_image_base64) 또는 공개 https URL(receipt_url)로 전달하면 CLOVA OCR 이 금액·가맹점·일자를 인식해 자동으로 검증·등록한다. 채팅에 첨부된 사진처럼 공개 URL 이 없을 때는 receipt_image_base64 사용을 권장한다. amount 를 직접 전달하면 OCR 없이 등록되며, spent_at 기준으로 진행 중 일정에 자동 귀속을 시도한다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "trip_id": {
            "type": "string"
          },
          "receipt_image_base64": {
            "type": "string",
            "description": "영수증 이미지의 base64 문자열(권장). data URI 접두어(data:image/...;base64,) 포함/미포함 모두 허용. 채팅 첨부 사진처럼 공개 URL 이 없을 때 사용."
          },
          "receipt_url": {
            "type": "string",
            "description": "영수증 이미지의 공개 https URL. OCR 엔진이 서버에서 직접 내려받아 인식한다."
          },
          "image_format": {
            "type": "string",
            "enum": [
              "jpg",
              "jpeg",
              "png",
              "pdf",
              "tiff"
            ],
            "description": "이미지 포맷(미지정 시 자동 감지, 기본 jpg)"
          },
          "amount": {
            "type": "number",
            "description": "OCR 없이 직접 등록할 금액(전달 시 OCR 생략)"
          },
          "currency": {
            "type": "string",
            "description": "입력 통화(기본=여행방 기준통화)"
          },
          "title": {
            "type": "string",
            "description": "가맹점/항목명"
          },
          "payer_member_id": {
            "type": "string",
            "description": "결제한 멤버 id"
          },
          "schedule_id": {
            "type": "string",
            "description": "귀속 일정 id"
          },
          "pay_method": {
            "type": "string",
            "enum": [
              "card",
              "cash"
            ],
            "default": "card"
          },
          "exchange_rate": {
            "type": "number",
            "description": "1 현지통화 = ? 기준통화. 미지정 시 실시간 환율 자동 조회"
          },
          "spent_at": {
            "type": "string",
            "description": "지출 시각 ISO8601"
          },
          "note": {
            "type": "string"
          },
          "actor_member_id": {
            "type": "string"
          },
          "trip_key": {
            "type": "string",
            "description": "보호 여행방의 접근키"
          },
          "split_mode": {
            "type": "string",
            "enum": [
              "equal",
              "custom",
              "payer"
            ],
            "default": "equal",
            "description": "equal=참여자 균등 N빵, custom=직접 분담, payer=결제자 전액"
          },
          "split_member_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "equal 분담 참여자(미지정 시 전원)"
          },
          "custom_shares": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "member_id": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                }
              },
              "required": [
                "member_id",
                "amount"
              ],
              "additionalProperties": false
            },
            "description": "custom 모드 멤버별 부담액(기준통화)"
          }
        },
        "required": [
          "trip_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "영수증 기반 비용 등록",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
