    {
      "name": "updateSchedule",
      "title": "일정 수정",
      "description": "[트립머니] 기존 일정을 수정한다. 현재 시간과 비교해 지연된 일정을 미루는 등 조정에 사용. viewer 권한은 거부된다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "schedule_id": {
            "type": "string"
          },
          "actor_member_id": {
            "type": "string",
            "description": "수정 주체 멤버 id (권한 검사)"
          },
          "title": {
            "type": "string"
          },
          "start_at": {
            "type": "string"
          },
          "end_at": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "planned_budget": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "ongoing",
              "done",
              "canceled"
            ]
          },
          "trip_key": {
            "type": "string",
            "description": "보호 여행방의 접근키"
          },
          "expected_updated_at": {
            "type": "string",
            "description": "낙관적 잠금: 마지막으로 읽은 updated_at(ISO). 그 사이 변경됐으면 거부"
          }
